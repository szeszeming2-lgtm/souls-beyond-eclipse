{
  "$schema": "../schemas/progression.schema.json",
  "version": 1,
  "level_cap": 3000,
  "xp_curve": {
    "reference_xp_per_minute": 100,
    "reward_growth_per_level": 0.05,
    "pace_points": [
      [1, 0.5],
      [10, 1.3],
      [30, 2.6],
      [60, 3.5],
      [100, 4.0],
      [250, 4.15],
      [500, 4.25],
      [1000, 4.4],
      [1700, 4.6],
      [2000, 4.7],
      [2700, 4.9],
      [2999, 5.0]
    ],
    "round_to": 5
  },
  "level_bands": [
    { "id": "bnd_opening_city", "name": "Seven Minutes of Night", "min": 1, "max": 250, "summary": "The eclipse over Akeboshi City, awakening, the Lantern Wardens, and the mirror city Ura-Akeboshi." },
    { "id": "bnd_hidden_capital", "name": "Lanterns in the Mist", "min": 251, "max": 700, "summary": "The hidden capital Amagiri, the six-faction council, trials, and a conspiracy hidden in the archives." },
    { "id": "bnd_silent_bell", "name": "The Silent Bell", "min": 701, "max": 1000, "summary": "Side arc in the frozen Shirokane Peaks: the Bellhold Monastery and the rival's companion story." },
    { "id": "bnd_tide_of_ink", "name": "Tide of Ink", "min": 1001, "max": 1700, "summary": "The Penumbral Synod invades. The war moves into the Inverse Tide and the Kurogane Caldera forges." },
    { "id": "bnd_two_suns", "name": "Two Suns", "min": 1701, "max": 2000, "summary": "In the floating palace the player faces their own shadow and gains a second power." },
    { "id": "bnd_hakumei_war", "name": "Hakumei", "min": 2001, "max": 2700, "summary": "Final war across overlapping realms, ending at the Sun Below." },
    { "id": "bnd_corona", "name": "Corona", "min": 2701, "max": 3000, "summary": "Endgame: dungeons, raids, a boss rush and secret bosses." }
  ],
  "milestones": {
    "interval": 50,
    "standard_reward": { "skill_points": 2, "currency": [{ "currency_id": "cur_marks", "amount": 500 }] },
    "major": [
      { "level": 100, "name": "Kindled", "reward": { "skill_points": 5, "title": "Kindled", "cosmetics": ["cos_aura_milestone_gold"], "unlocks": ["Second loadout slot"] } },
      { "level": 500, "name": "Lantern-Bearer", "reward": { "skill_points": 8, "title": "Lantern-Bearer", "unlocks": ["Third loadout slot"] } },
      { "level": 1000, "name": "Thousandfold Flame", "reward": { "skill_points": 10, "title": "Thousandfold Flame" } },
      { "level": 1500, "name": "Ink-Walker", "reward": { "skill_points": 10, "title": "Ink-Walker" } },
      { "level": 2000, "name": "Twin Sun", "reward": { "skill_points": 12, "title": "Twin Sun" } },
      { "level": 2500, "name": "Hakumei Veteran", "reward": { "skill_points": 12, "title": "Hakumei Veteran" } },
      { "level": 3000, "name": "Eclipse Eternal", "reward": { "skill_points": 15, "title": "Eclipse Eternal", "unlocks": ["Secret boss gallery"] } }
    ]
  },
  "skill_points": {
    "schedule": [
      { "from": 2, "to": 100, "every": 1 },
      { "from": 101, "to": 3000, "every": 10 }
    ]
  },
  "stat_scaling": {
    "growth_per_level": 0.05,
    "player_base": { "max_hp": 500, "attack": 50, "defense": 25 },
    "enemy_base": { "max_hp": 400, "attack": 40, "defense": 20 },
    "spirit_max": 100
  },
  "level_sync": { "enabled": true, "margin_levels": 15, "synced_reward_multiplier": 0.8 },
  "catch_up": {
    "below_recommended_by": 10,
    "bonus_per_level_below": 0.03,
    "max_bonus": 0.75,
    "returning_player": { "days_away": 14, "bonus_multiplier": 1.5, "bonus_minutes": 120 }
  },
  "anti_grind": { "window_s": 600, "full_reward_kills": 20, "decay_per_kill": 0.85, "floor_multiplier": 0.25 },
  "anti_exploit": { "xp_rate_alarm_factor": 8, "max_reward_events_per_second": 10, "action": "log_and_clamp" },
  "xp_sources": [
    { "id": "story_mission", "name": "Story mission", "kind": "story_mission", "base_xp": 2400, "typical_minutes": 18, "repeatable": false },
    { "id": "side_quest", "name": "Side quest", "kind": "side_quest", "base_xp": 900, "typical_minutes": 9, "repeatable": false },
    { "id": "discovery", "name": "Landmark or secret found", "kind": "exploration", "base_xp": 250, "typical_minutes": 3, "repeatable": false },
    { "id": "field_enemy", "name": "Field enemy defeated", "kind": "combat", "base_xp": 12, "typical_minutes": 0.25, "repeatable": true },
    { "id": "boss", "name": "Boss defeated (first time)", "kind": "boss", "base_xp": 1500, "typical_minutes": 8, "repeatable": false },
    { "id": "dungeon", "name": "Dungeon run", "kind": "dungeon", "base_xp": 3600, "typical_minutes": 25, "repeatable": true },
    { "id": "training", "name": "Training challenge", "kind": "training", "base_xp": 300, "typical_minutes": 4, "repeatable": true },
    { "id": "faction_mission", "name": "Faction mission", "kind": "faction_mission", "base_xp": 1400, "typical_minutes": 12, "repeatable": true },
    { "id": "group_activity", "name": "Optional group activity", "kind": "group_activity", "base_xp": 2000, "typical_minutes": 15, "repeatable": true }
  ],
  "respec": { "allowed_anytime": true, "currency_cost": 0 },
  "currencies": [
    { "id": "cur_marks", "name": "Marks", "description": "Warden-issued coins, accepted everywhere the lanterns still burn.", "max": 1000000000000 }
  ]
}
