{
  "$schema": "./schemas/skill_trees.schema.json",
  "version": 1,
  "entries": [
    {
      "id": "skt_lanternblade",
      "name": "Way of the Lantern",
      "archetype_id": "arc_lanternblade",
      "nodes": [
        {
          "id": "steady_hand",
          "name": "Steady Hand",
          "description": "Your guard holds better under pressure.",
          "cost_points": 1,
          "requires": [],
          "effect": { "type": "stat_bonus", "stat_modifier": { "stat": "guard_strength", "mode": "add_percent", "value": 10 } },
          "grid": { "column": 2, "row": 0 }
        },
        {
          "id": "lantern_volley",
          "name": "Lantern Volley",
          "description": "Learn Lantern Volley: three floating lanterns that seek nearby enemies.",
          "cost_points": 2,
          "min_level": 10,
          "requires": ["steady_hand"],
          "effect": { "type": "unlock_ability", "ability_id": "abl_lantern_volley" },
          "grid": { "column": 1, "row": 1 }
        },
        {
          "id": "wick_mastery",
          "name": "Wick Mastery",
          "description": "Lets you buy Wickflare upgrades at a hub.",
          "cost_points": 2,
          "requires": ["steady_hand"],
          "effect": { "type": "ability_upgrade", "ability_id": "abl_wickflare" },
          "grid": { "column": 3, "row": 1 }
        },
        {
          "id": "patient_flame",
          "name": "Patient Flame",
          "description": "Spirit energy refills faster.",
          "cost_points": 1,
          "requires": ["lantern_volley"],
          "effect": { "type": "stat_bonus", "stat_modifier": { "stat": "spirit_regen", "mode": "add_percent", "value": 15 } },
          "grid": { "column": 1, "row": 2 }
        },
        {
          "id": "ember_edge",
          "name": "Ember Edge",
          "description": "Your strikes burn a little hotter.",
          "cost_points": 1,
          "requires": ["wick_mastery"],
          "effect": { "type": "stat_bonus", "stat_modifier": { "stat": "attack", "mode": "add_percent", "value": 5 } },
          "grid": { "column": 3, "row": 2 }
        },
        {
          "id": "warden_resolve",
          "name": "Warden's Resolve",
          "description": "More health, earned the hard way.",
          "cost_points": 2,
          "min_level": 25,
          "requires": ["patient_flame", "ember_edge"],
          "effect": { "type": "stat_bonus", "stat_modifier": { "stat": "max_hp", "mode": "add_percent", "value": 8 } },
          "grid": { "column": 2, "row": 3 }
        }
      ],
      "dev_status": "data_only"
    }
  ]
}
