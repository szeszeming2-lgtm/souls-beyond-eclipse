{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Difficulty modes, boss assists and the no-harsh-failure rules",
  "type": "object",
  "required": ["$schema", "version", "default_mode", "switchable_anytime", "modes", "boss_assist", "death"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/file_version" },
    "default_mode": { "enum": ["story", "normal", "hard", "challenge"] },
    "switchable_anytime": { "const": true },
    "modes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "enemy_damage_mult", "enemy_hp_mult", "telegraph_time_mult", "parry_window_mult", "dodge_window_mult", "max_attackers_per_player", "optional"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["story", "normal", "hard", "challenge"] },
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "description": { "$ref": "common.schema.json#/$defs/short_text" },
          "enemy_damage_mult": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
          "enemy_hp_mult": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
          "telegraph_time_mult": { "type": "number", "minimum": 0.5, "maximum": 3, "description": "Above 1 = enemy wind-ups last longer (easier to read)." },
          "parry_window_mult": { "type": "number", "minimum": 0.5, "maximum": 3 },
          "dodge_window_mult": { "type": "number", "minimum": 0.5, "maximum": 3 },
          "max_attackers_per_player": { "type": "integer", "minimum": 1, "maximum": 8 },
          "optional": { "type": "boolean", "description": "Challenge mode is opt-in and never required." },
          "reward_note": { "$ref": "common.schema.json#/$defs/short_text" }
        }
      }
    },
    "boss_assist": {
      "type": "object",
      "description": "Offers after repeated boss failures. Every offer can be declined.",
      "required": ["always_optional", "offer_after_failures", "support_buff_status_id"],
      "additionalProperties": false,
      "properties": {
        "always_optional": { "const": true },
        "offer_after_failures": {
          "type": "object",
          "required": ["tip", "suggested_level", "training_challenge", "support_buff"],
          "additionalProperties": false,
          "properties": {
            "tip": { "type": "integer", "minimum": 1, "maximum": 20 },
            "suggested_level": { "type": "integer", "minimum": 1, "maximum": 20 },
            "training_challenge": { "type": "integer", "minimum": 1, "maximum": 20 },
            "support_buff": { "type": "integer", "minimum": 1, "maximum": 20 }
          }
        },
        "support_buff_status_id": { "$ref": "common.schema.json#/$defs/status_ref" }
      }
    },
    "death": {
      "type": "object",
      "required": ["lose_progress", "lose_items", "respawn_at", "respawn_currency_cost"],
      "additionalProperties": false,
      "properties": {
        "lose_progress": { "const": false },
        "lose_items": { "const": false },
        "respawn_at": { "enum": ["last_checkpoint"] },
        "respawn_currency_cost": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Kept tiny or zero: respawns are cheap." }
      }
    }
  }
}
