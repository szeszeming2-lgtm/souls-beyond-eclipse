{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weapons",
  "type": "object",
  "required": ["$schema", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/file_version" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/weapon" } }
  },
  "$defs": {
    "weapon": {
      "type": "object",
      "required": [
        "id", "name", "category", "weapon_class", "rarity", "level_req", "description", "base_stats",
        "moveset_id", "special_ability_id", "passive_ability_id", "upgrade_tiers", "unlock_source",
        "presentation", "balance_notes", "dev_status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/weapon_id" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "category": { "const": "weapon" },
        "weapon_class": { "$ref": "common.schema.json#/$defs/weapon_class" },
        "rarity": { "$ref": "common.schema.json#/$defs/rarity" },
        "level_req": { "$ref": "common.schema.json#/$defs/level" },
        "description": { "$ref": "common.schema.json#/$defs/text" },
        "base_stats": {
          "type": "object",
          "required": ["damage", "attack_speed", "range_studs"],
          "additionalProperties": false,
          "properties": {
            "damage": { "type": "number", "minimum": 10, "maximum": 1000, "description": "Weapon power. 100 = baseline; final attack = character attack x damage / 100." },
            "attack_speed": { "type": "number", "minimum": 0.5, "maximum": 2, "description": "Animation speed multiplier. 1 = baseline." },
            "range_studs": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 }
          }
        },
        "moveset_id": { "$ref": "common.schema.json#/$defs/moveset_ref" },
        "special_ability_id": { "$ref": "common.schema.json#/$defs/ability_ref" },
        "passive_ability_id": { "$ref": "common.schema.json#/$defs/ability_ref" },
        "ultimate_ability_id": { "$ref": "common.schema.json#/$defs/ability_ref" },
        "upgrade_tiers": {
          "type": "array",
          "description": "Exactly 5 tiers, in order 1 to 5.",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/upgrade_tier" }
        },
        "unlock_source": { "$ref": "common.schema.json#/$defs/unlock_source" },
        "presentation": { "$ref": "common.schema.json#/$defs/presentation" },
        "balance_notes": { "$ref": "common.schema.json#/$defs/notes" },
        "dev_status": { "$ref": "common.schema.json#/$defs/dev_status" }
      }
    },
    "upgrade_tier": {
      "type": "object",
      "required": ["tier", "damage_bonus_pct", "materials", "currency_cost"],
      "additionalProperties": false,
      "properties": {
        "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
        "damage_bonus_pct": { "type": "number", "minimum": 0, "maximum": 300, "description": "Total bonus at this tier (not added on top of the previous tier)." },
        "min_level": { "$ref": "common.schema.json#/$defs/level" },
        "materials": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/material_cost" } },
        "currency_cost": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "note": { "$ref": "common.schema.json#/$defs/short_text" }
      }
    }
  }
}
