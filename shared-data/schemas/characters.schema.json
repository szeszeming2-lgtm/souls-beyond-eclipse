{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story characters (NPCs, rivals, companions). The player character is built in customization.json.",
  "type": "object",
  "required": ["$schema", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/file_version" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/character" } }
  },
  "$defs": {
    "character": {
      "type": "object",
      "required": ["id", "name", "role", "bio", "companion_story", "dev_status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/character_id" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "title": { "$ref": "common.schema.json#/$defs/name" },
        "role": { "enum": ["mentor", "rival", "companion", "vendor", "quest_giver", "antagonist", "faction_leader"] },
        "faction_id": { "$ref": "common.schema.json#/$defs/faction_ref" },
        "bio": { "$ref": "common.schema.json#/$defs/text" },
        "personality": { "$ref": "common.schema.json#/$defs/short_text" },
        "first_quest_id": { "$ref": "common.schema.json#/$defs/quest_ref" },
        "companion_story": { "type": "boolean", "description": "Has an optional companion story line." },
        "portrait": { "$ref": "common.schema.json#/$defs/asset_ref" },
        "dev_status": { "$ref": "common.schema.json#/$defs/dev_status" }
      }
    }
  }
}
