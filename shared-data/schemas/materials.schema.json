{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Materials (upgrade and crafting ingredients)",
  "type": "object",
  "required": ["$schema", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/file_version" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/material" } }
  },
  "$defs": {
    "material": {
      "type": "object",
      "required": ["id", "name", "category", "rarity", "description", "max_stack", "sources", "dev_status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/material_id" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "category": { "const": "material" },
        "rarity": { "$ref": "common.schema.json#/$defs/rarity" },
        "description": { "$ref": "common.schema.json#/$defs/short_text" },
        "max_stack": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/unlock_source" } },
        "sell_value": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "icon": { "$ref": "common.schema.json#/$defs/asset_ref" },
        "dev_status": { "$ref": "common.schema.json#/$defs/dev_status" }
      }
    }
  }
}
