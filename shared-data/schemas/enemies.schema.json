{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enemies and bosses",
  "type": "object",
  "required": ["$schema", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/file_version" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/enemy" } }
  },
  "$defs": {
    "enemy": {
      "type": "object",
      "required": ["id", "name", "family", "rank", "description", "region_ids", "stats", "ai_profile", "attacks", "rewards", "presentation", "dev_status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/enemy_id" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "family": { "$ref": "common.schema.json#/$defs/local_id" },
        "rank": { "enum": ["minion", "elite", "boss", "secret_boss"] },
        "description": { "$ref": "common.schema.json#/$defs/text" },
        "region_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/region_ref" } },
        "stats": {
          "type": "object",
          "description": "Multipliers on the standard enemy stats for the enemy's level (see progression.json stat_scaling).",
          "required": ["hp_mult", "attack_mult", "defense_mult", "poise", "move_speed_studs", "aggro_range_studs", "leash_range_studs"],
          "additionalProperties": false,
          "properties": {
            "hp_mult": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 },
            "attack_mult": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
            "defense_mult": { "type": "number", "minimum": 0, "maximum": 20 },
            "poise": { "type": "number", "minimum": 0, "maximum": 5000, "description": "Stagger resistance. Higher = takes more hits to stagger." },
            "move_speed_studs": { "type": "number", "minimum": 0, "maximum": 100 },
            "aggro_range_studs": { "type": "number", "minimum": 0, "maximum": 300 },
            "leash_range_studs": { "type": "number", "minimum": 0, "maximum": 1000 }
          }
        },
        "ai_profile": { "enum": ["melee_skirmisher", "ranged_kiter", "brute", "swarm", "boss_scripted"] },
        "attacks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attack" } },
        "resistances": {
          "type": "object",
          "description": "Damage taken multiplier per damage type. 1 = normal, 0.5 = resists, 1.5 = weak.",
          "propertyNames": { "$ref": "common.schema.json#/$defs/damage_type" },
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 3 }
        },
        "rewards": {
          "type": "object",
          "required": ["xp_base", "currency_base", "drops"],
          "additionalProperties": false,
          "properties": {
            "xp_base": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "currency_base": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "drops": { "type": "array", "items": { "$ref": "#/$defs/drop" } }
          }
        },
        "boss": { "$ref": "#/$defs/boss" },
        "presentation": { "$ref": "common.schema.json#/$defs/presentation" },
        "dev_status": { "$ref": "common.schema.json#/$defs/dev_status" }
      },
      "if": { "properties": { "rank": { "enum": ["boss", "secret_boss"] } } },
      "then": { "required": ["boss"] },
      "else": { "not": { "required": ["boss"] } }
    },
    "attack": {
      "type": "object",
      "required": ["id", "name", "power", "damage_type", "timing", "range_studs", "area", "avoidable_by", "tell", "knockback_studs", "poise_damage", "cooldown_s"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/local_id" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "power": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        "damage_type": { "$ref": "common.schema.json#/$defs/damage_type" },
        "timing": { "$ref": "common.schema.json#/$defs/timing" },
        "range_studs": { "type": "number", "exclusiveMinimum": 0, "maximum": 400 },
        "area": { "$ref": "common.schema.json#/$defs/area" },
        "avoidable_by": {
          "description": "Every attack must be avoidable. An attack without 'guard' is unblockable and must be dodgeable with a longer tell.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["dodge", "guard", "parry", "move_out"] }
        },
        "tell": {
          "type": "object",
          "description": "How the player can see or hear the attack coming.",
          "required": ["visual", "audio_cue"],
          "additionalProperties": false,
          "properties": {
            "visual": { "enum": ["body_glow", "ground_marker", "wind_up_pose", "weapon_flash"] },
            "audio_cue": { "type": "boolean" },
            "unblockable_marker": { "type": "boolean", "description": "Shows the special unblockable warning. Required for unblockable attacks." }
          }
        },
        "knockback_studs": { "type": "number", "minimum": 0, "maximum": 30 },
        "poise_damage": { "type": "number", "minimum": 0, "maximum": 200 },
        "cooldown_s": { "type": "number", "minimum": 0, "maximum": 120 },
        "status_effects": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/status_application" } }
      }
    },
    "drop": {
      "type": "object",
      "required": ["item_id", "chance", "qty_min", "qty_max"],
      "additionalProperties": false,
      "properties": {
        "item_id": { "$ref": "common.schema.json#/$defs/item_ref" },
        "chance": { "$ref": "common.schema.json#/$defs/fraction" },
        "qty_min": { "type": "integer", "minimum": 1, "maximum": 999 },
        "qty_max": { "type": "integer", "minimum": 1, "maximum": 999 }
      }
    },
    "boss": {
      "type": "object",
      "required": ["title", "arena_id", "music", "intro_skippable", "checkpoint_each_phase", "phases", "assist_tips"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "common.schema.json#/$defs/name" },
        "arena_id": { "$ref": "common.schema.json#/$defs/arena_ref" },
        "music": { "$ref": "common.schema.json#/$defs/asset_ref" },
        "intro_skippable": { "const": true },
        "checkpoint_each_phase": { "type": "boolean" },
        "phases": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/phase" } },
        "assist_tips": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/short_text" }, "description": "Shown when a player who keeps failing accepts a tip." },
        "suggested_level": { "$ref": "common.schema.json#/$defs/level" }
      }
    },
    "phase": {
      "type": "object",
      "required": ["id", "name", "starts_at_hp", "attack_ids", "speed_mult", "transition_invulnerable_s"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/local_id" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "starts_at_hp": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Fraction of max HP at which this phase begins. The first phase starts at 1." },
        "attack_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/local_id" } },
        "speed_mult": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "transition_invulnerable_s": { "type": "number", "minimum": 0, "maximum": 10 },
        "notes": { "$ref": "common.schema.json#/$defs/notes" }
      }
    }
  }
}
