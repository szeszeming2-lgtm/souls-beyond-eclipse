{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factions",
  "type": "object",
  "required": ["$schema", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/file_version" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/faction" } }
  },
  "$defs": {
    "faction": {
      "type": "object",
      "required": ["id", "name", "motto", "description", "combat_identity", "playable", "archetype_ids", "theme_color", "dev_status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/faction_id" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "motto": { "$ref": "common.schema.json#/$defs/short_text" },
        "description": { "$ref": "common.schema.json#/$defs/text" },
        "combat_identity": { "$ref": "common.schema.json#/$defs/short_text" },
        "playable": { "type": "boolean", "description": "False for enemy-only factions." },
        "archetype_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/archetype_ref" } },
        "home_region_id": { "$ref": "common.schema.json#/$defs/region_ref" },
        "theme_color": { "$ref": "common.schema.json#/$defs/color_hex" },
        "dev_status": { "$ref": "common.schema.json#/$defs/dev_status" }
      },
      "if": { "properties": { "playable": { "const": true } } },
      "then": { "properties": { "archetype_ids": { "minItems": 1 } } }
    }
  }
}
