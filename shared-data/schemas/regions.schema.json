{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World regions. Detailed layouts live in shared-data/maps/.",
  "type": "object",
  "required": ["$schema", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/file_version" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/region" } }
  },
  "$defs": {
    "region": {
      "type": "object",
      "required": ["id", "name", "theme", "description", "band_id", "level_range", "map_ids", "connects_to", "boss_ids", "landmark_summary", "dev_status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/region_id" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "theme": { "$ref": "common.schema.json#/$defs/short_text" },
        "description": { "$ref": "common.schema.json#/$defs/text" },
        "band_id": { "$ref": "common.schema.json#/$defs/band_ref" },
        "level_range": { "$ref": "common.schema.json#/$defs/level_range" },
        "map_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/map_ref" } },
        "connects_to": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/region_ref" } },
        "boss_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/enemy_ref" } },
        "landmark_summary": { "$ref": "common.schema.json#/$defs/short_text" },
        "story_beats": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/short_text" } },
        "dev_status": { "$ref": "common.schema.json#/$defs/dev_status" }
      }
    }
  }
}
