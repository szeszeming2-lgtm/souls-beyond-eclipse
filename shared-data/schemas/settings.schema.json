{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Player settings: every option the Settings menu shows, with its default and limits. The menu is built from this file.",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "tabs",
    "settings"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/file_version"
    },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/local_id"
          },
          "label": {
            "$ref": "common.schema.json#/$defs/name"
          }
        }
      }
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/setting"
      }
    }
  },
  "$defs": {
    "setting": {
      "type": "object",
      "required": [
        "id",
        "tab",
        "label",
        "kind",
        "default",
        "platforms"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/local_id"
        },
        "tab": {
          "$ref": "common.schema.json#/$defs/local_id"
        },
        "label": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "help": {
          "$ref": "common.schema.json#/$defs/short_text"
        },
        "kind": {
          "enum": [
            "toggle",
            "slider",
            "choice"
          ]
        },
        "default": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "$ref": "common.schema.json#/$defs/local_id"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/name"
              }
            }
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "roblox",
              "pc"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "toggle"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "slider"
              }
            }
          },
          "then": {
            "required": [
              "min",
              "max",
              "step"
            ],
            "properties": {
              "default": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
