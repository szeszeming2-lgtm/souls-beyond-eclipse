{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character creation options. Cosmetics are earned by playing and never give power: this schema has no stat fields on purpose.",
  "type": "object",
  "required": ["$schema", "version", "name_rules", "max_saved_presets", "categories", "options"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/file_version" },
    "name_rules": {
      "type": "object",
      "required": ["min_length", "max_length", "filter"],
      "additionalProperties": false,
      "properties": {
        "min_length": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_length": { "type": "integer", "minimum": 3, "maximum": 30 },
        "filter": { "const": "platform_text_filter", "description": "Roblox: TextService filtering is required for player-typed names." }
      }
    },
    "max_saved_presets": { "type": "integer", "minimum": 1, "maximum": 20 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "multi_select"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/category_id" },
          "label": { "$ref": "common.schema.json#/$defs/name" },
          "multi_select": { "type": "boolean" },
          "max_selected": { "type": "integer", "minimum": 1, "maximum": 10 }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "name", "unlock", "is_default", "dev_status"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/cosmetic_id" },
          "category": { "$ref": "#/$defs/category_id" },
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "color": { "$ref": "common.schema.json#/$defs/color_hex" },
          "asset": { "$ref": "common.schema.json#/$defs/asset_ref" },
          "unlock": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["starter", "quest", "boss", "milestone", "exploration", "achievement", "faction"] },
              "ref_id": {
                "type": "string",
                "pattern": "^(?:qst|enm|reg|fac|sec|lmk)_[a-z0-9]+(?:_[a-z0-9]+)*$",
                "x-ref": ["qst", "enm", "reg", "fac", "sec", "lmk"]
              },
              "note": { "$ref": "common.schema.json#/$defs/short_text" }
            }
          },
          "is_default": { "type": "boolean" },
          "dev_status": { "$ref": "common.schema.json#/$defs/dev_status" }
        }
      }
    }
  },
  "$defs": {
    "category_id": {
      "enum": ["body_type", "face", "skin_tone", "hair_style", "hair_color", "eye_color", "outfit", "accessory", "aura_color"]
    }
  }
}
