{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archetypes (combat styles a player can learn)",
  "type": "object",
  "required": ["$schema", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/file_version" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/archetype" } }
  },
  "$defs": {
    "archetype": {
      "type": "object",
      "required": ["id", "name", "faction_id", "role_summary", "weapon_classes", "ease_of_play", "dev_status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/archetype_id" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "faction_id": { "$ref": "common.schema.json#/$defs/faction_ref" },
        "role_summary": { "$ref": "common.schema.json#/$defs/short_text" },
        "playstyle": { "$ref": "common.schema.json#/$defs/text" },
        "weapon_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/weapon_class" } },
        "ease_of_play": { "type": "integer", "minimum": 1, "maximum": 3, "description": "1 = easiest to pick up." },
        "default_moveset_id": { "$ref": "common.schema.json#/$defs/moveset_ref" },
        "basic_attack_note": { "$ref": "common.schema.json#/$defs/short_text" },
        "defensive_ability_id": { "$ref": "common.schema.json#/$defs/ability_ref" },
        "mobility_ability_id": { "$ref": "common.schema.json#/$defs/ability_ref" },
        "starting_ability_id": { "$ref": "common.schema.json#/$defs/ability_ref" },
        "unlockable_ability_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/ability_ref" } },
        "ultimate_ability_id": { "$ref": "common.schema.json#/$defs/ability_ref" },
        "skill_tree_id": { "$ref": "common.schema.json#/$defs/skill_tree_ref" },
        "dev_status": { "$ref": "common.schema.json#/$defs/dev_status" }
      },
      "if": { "properties": { "dev_status": { "const": "concept" } } },
      "else": {
        "description": "Anything beyond a concept must have its full kit wired up.",
        "required": ["default_moveset_id", "defensive_ability_id", "mobility_ability_id", "starting_ability_id", "unlockable_ability_ids", "ultimate_ability_id", "skill_tree_id"]
      }
    }
  }
}
