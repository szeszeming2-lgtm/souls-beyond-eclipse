{
  "$schema": "./schemas/settings.schema.json",
  "version": 1,
  "tabs": [
    {
      "id": "gameplay",
      "label": "Gameplay"
    },
    {
      "id": "graphics",
      "label": "Graphics"
    },
    {
      "id": "controls",
      "label": "Controls"
    },
    {
      "id": "audio",
      "label": "Audio"
    },
    {
      "id": "accessibility",
      "label": "Accessibility"
    },
    {
      "id": "language",
      "label": "Language"
    }
  ],
  "settings": [
    {
      "id": "difficulty",
      "tab": "gameplay",
      "label": "Difficulty",
      "kind": "choice",
      "default": "normal",
      "options": [
        {
          "value": "story",
          "label": "Story"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "hard",
          "label": "Hard"
        },
        {
          "value": "challenge",
          "label": "Challenge"
        }
      ],
      "platforms": [
        "roblox",
        "pc"
      ],
      "help": "Change any time. Story mode: softer hits and longer enemy wind-ups."
    },
    {
      "id": "damage_numbers",
      "tab": "gameplay",
      "label": "Damage numbers",
      "kind": "toggle",
      "default": true,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "effects_quality",
      "tab": "graphics",
      "label": "Effects quality",
      "kind": "choice",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "low",
          "label": "Low"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "high",
          "label": "High"
        },
        {
          "value": "ultra",
          "label": "Ultra"
        }
      ],
      "platforms": [
        "roblox"
      ],
      "help": "Controls the game's own effects. Overall rendering quality is in Roblox's menu (Esc > Settings)."
    },
    {
      "id": "camera_sensitivity",
      "tab": "controls",
      "label": "Camera sensitivity",
      "kind": "slider",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "invert_camera_y",
      "tab": "controls",
      "label": "Invert camera Y",
      "kind": "toggle",
      "default": false,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "gamepad_sensitivity",
      "tab": "controls",
      "label": "Gamepad sensitivity",
      "kind": "slider",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "vibration",
      "tab": "controls",
      "label": "Vibration",
      "kind": "toggle",
      "default": true,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "right_click",
      "tab": "controls",
      "label": "Right mouse button",
      "kind": "choice",
      "default": "heavy",
      "options": [
        {
          "value": "heavy",
          "label": "Heavy attack"
        },
        {
          "value": "guard",
          "label": "Guard / parry"
        }
      ],
      "platforms": [
        "roblox",
        "pc"
      ],
      "help": "Guard moves to C when right-click is heavy attack, and heavy moves to C otherwise."
    },
    {
      "id": "touch_layout",
      "tab": "controls",
      "label": "Touch layout",
      "kind": "choice",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "one_handed_left",
          "label": "One-handed (left)"
        },
        {
          "value": "one_handed_right",
          "label": "One-handed (right)"
        }
      ],
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "touch_ui_scale",
      "tab": "controls",
      "label": "Touch button size",
      "kind": "slider",
      "default": 1,
      "min": 0.75,
      "max": 1.5,
      "step": 0.05,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "master_volume",
      "tab": "audio",
      "label": "Master volume",
      "kind": "slider",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.1,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "music_volume",
      "tab": "audio",
      "label": "Music volume",
      "kind": "slider",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "step": 0.1,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "sfx_volume",
      "tab": "audio",
      "label": "Effects volume",
      "kind": "slider",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.1,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "subtitles",
      "tab": "accessibility",
      "label": "Subtitles",
      "kind": "toggle",
      "default": true,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "text_scale",
      "tab": "accessibility",
      "label": "Text size",
      "kind": "slider",
      "default": 1,
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "platforms": [
        "roblox",
        "pc"
      ]
    },
    {
      "id": "camera_shake",
      "tab": "accessibility",
      "label": "Camera shake",
      "kind": "slider",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.1,
      "platforms": [
        "roblox",
        "pc"
      ],
      "help": "0 turns camera shake off."
    },
    {
      "id": "flash_intensity",
      "tab": "accessibility",
      "label": "Flash intensity",
      "kind": "slider",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.1,
      "platforms": [
        "roblox",
        "pc"
      ],
      "help": "Hit flashes and bright effects."
    },
    {
      "id": "motion_intensity",
      "tab": "accessibility",
      "label": "Motion intensity",
      "kind": "slider",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.1,
      "platforms": [
        "roblox",
        "pc"
      ],
      "help": "Screen motion such as hit-stop and camera sway."
    },
    {
      "id": "colorblind",
      "tab": "accessibility",
      "label": "Colour-blind mode",
      "kind": "choice",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "Off"
        },
        {
          "value": "protanopia",
          "label": "Protanopia"
        },
        {
          "value": "deuteranopia",
          "label": "Deuteranopia"
        },
        {
          "value": "tritanopia",
          "label": "Tritanopia"
        }
      ],
      "platforms": [
        "roblox",
        "pc"
      ],
      "help": "Changes warning colours so attack tells stay easy to see."
    },
    {
      "id": "language",
      "tab": "language",
      "label": "Language",
      "kind": "choice",
      "default": "en",
      "options": [
        {
          "value": "en",
          "label": "English"
        }
      ],
      "platforms": [
        "roblox",
        "pc"
      ],
      "help": "More languages come later."
    }
  ]
}
