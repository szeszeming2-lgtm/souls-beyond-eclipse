{
  "name": "SoulsBeyondEclipse",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": false,
        "EnableMouseLockOption": false,
        "AutoJumpEnabled": false,
        "CharacterWalkSpeed": 16
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$path": "src/character"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 19.3,
        "Brightness": 1.6,
        "Ambient": [0.33, 0.33, 0.4],
        "OutdoorAmbient": [0.45, 0.45, 0.55],
        "GlobalShadows": true,
        "FogStart": 300,
        "FogEnd": 1400,
        "FogColor": [0.16, 0.16, 0.24]
      }
    }
  }
}
